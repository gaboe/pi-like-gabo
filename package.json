{
  "name": "@gabrielecegi/pi-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Locally owned, reviewed Pi extensions.",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension"],
  "scripts": {
    "build:comment-checker": "bash scripts/build-comment-checker.sh",
    "setup:ben": "bash scripts/setup-ben-plugins.sh",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'extensions/**/*.test.mjs'"
  },
  "pi": {
    "extensions": [
      "./extensions/multi-skills/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/btw/index.ts",
      "./extensions/comment-checker/index.ts",
      "./vendor/pi-caveman/extensions/caveman.ts",
      "./vendor/my-pi-setup/extensions/ask-user/index.ts",
      "./vendor/my-pi-setup/extensions/copy-all/index.ts",
      "./vendor/my-pi-setup/extensions/firecrawl-search/index.ts",
      "./vendor/my-pi-setup/extensions/git-info/index.ts",
      "./vendor/my-pi-setup/extensions/model-info/index.ts",
      "./vendor/my-pi-setup/extensions/subagents/index.ts",
      "./vendor/my-pi-setup/extensions/ui-customization/index.ts",
      "./vendor/my-pi-setup/extensions/workflows/index.ts"
    ],
    "skills": ["./vendor/my-pi-setup/skills/subagents"],
    "themes": ["./vendor/my-pi-setup/themes/github-dark-default.json"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typebox": "1.1.38",
    "typescript": "6.0.2"
  }
}
