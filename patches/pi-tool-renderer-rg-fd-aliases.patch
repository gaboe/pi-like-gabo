--- /dev/null
+++ b/extensions/__tests__/batch-aliases.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, test } from "bun:test";
+
+import { normalizeBatchCalls, ToolBatchParams } from "../tool-renderer/batch.js";
+
+describe("tool_batch compatibility aliases", () => {
+	test("schema accepts rg and fd before execution", () => {
+		expect(ToolBatchParams.properties.calls.items.properties.tool.enum).toContain("rg");
+		expect(ToolBatchParams.properties.calls.items.properties.tool.enum).toContain("fd");
+	});
+
+	test("normalizes the transcript-shaped rg/read/fd payload", () => {
+		expect(
+			normalizeBatchCalls([
+				{
+					tool: "rg",
+					args: {
+						path: "/tmp/package",
+						pattern: "styledCodeBlocks|303030",
+						glob: "*.{ts,js,json}",
+						context: 5,
+						limit: 200,
+					},
+				},
+				{ tool: "read", args: { path: "/tmp/package/package.json" } },
+				{ tool: "fd", args: { path: "/tmp/package", pattern: "test", limit: 100 } },
+			]),
+		).toEqual([
+			{
+				tool: "grep",
+				args: {
+					path: "/tmp/package",
+					pattern: "styledCodeBlocks|303030",
+					glob: "*.{ts,js,json}",
+					context: 5,
+					limit: 200,
+				},
+			},
+			{ tool: "read", args: { path: "/tmp/package/package.json" } },
+			{ tool: "find", args: { path: "/tmp/package", pattern: "*test*", limit: 100 } },
+		]);
+	});
+
+	test("drops unsupported tools without rewriting them", () => {
+		expect(normalizeBatchCalls([{ tool: "edit", args: { path: "x" } }])).toEqual([]);
+	});
+});
